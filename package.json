{
  "name": "obby-steal-egg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A first-person egg-heist game: sneak into guarded nests, steal eggs, escape the guardians, hatch pets and build an income empire.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "python tools/blender/build_all.py",
    "models:clean": "python tools/blender/build_all.py --clean"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
